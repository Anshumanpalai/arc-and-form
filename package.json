{
  "name": "commerce-portfolio",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "workspaces": [
    "client",
    "server-node"
  ],
  "scripts": {
    "dev": "concurrently -n api,web -c blue,magenta \"npm run dev --workspace=server-node\" \"npm run dev --workspace=client\"",
    "dev:api": "npm run dev --workspace=server-node",
    "dev:web": "npm run dev --workspace=client",
    "seed": "npm run seed --workspace=server-node",
    "build": "npm run build --workspace=client",
    "test": "npm test --workspace=server-node && npm test --workspace=client",
    "lint": "npm run lint --workspace=client"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
