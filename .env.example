# ==============================================================================
# ARC & FORM — Environment Configuration Template (MERN Stack)
# ==============================================================================

# Server Configuration
PORT=5000
NODE_ENV=development

# MongoDB Connection
# Set MONGODB_URI to your local or hosted MongoDB instance (replica set required for ACID transactions).
# For zero-setup offline dev/testing, set USE_MEMORY_DB=true.
MONGODB_URI=mongodb://localhost:27017/arcandform
USE_MEMORY_DB=false

# Authentication & Security
# - Cookie name: arc_token
# - Cookie SameSite: Lax (dev) / None (prod cross-origin)
# - Cookie Secure: false (dev) / true (prod)
# - Expiration: 7 days (604800000 ms)
JWT_SECRET=arc_and_form_dev_secret_key_change_in_production_min_32_chars
JWT_EXPIRATION_MS=604800000
COOKIE_NAME=arc_token
COOKIE_SECURE=false
COOKIE_SAME_SITE=Lax

# CORS Configuration
# Comma-separated list of allowed origins matching frontend dev & preview ports
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:5175,http://localhost:3000

# Client Frontend URL
CLIENT_URL=http://localhost:5173

# Stripe Payment Gateway (Test Mode)
# Obtain test keys from https://dashboard.stripe.com/test/apikeys
STRIPE_SECRET_KEY=sk_test_placeholder
STRIPE_WEBHOOK_SECRET=whsec_placeholder
STRIPE_SUCCESS_URL=http://localhost:5173/checkout/success?session_id={CHECKOUT_SESSION_ID}
STRIPE_CANCEL_URL=http://localhost:5173/checkout?cancelled=true

# Cloudinary Media Storage
# Obtain from https://cloudinary.com/console; left blank for development mock mode
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Frontend Environment
VITE_API_URL=http://localhost:5000
