# ==============================================================================
# ARC & FORM Node.js / Express Environment Configuration
# ==============================================================================

# Server Configuration
PORT=5000
NODE_ENV=development

# MongoDB Connection
# Set MONGODB_URI to your local or hosted MongoDB instance (replica set recommended for transactions).
MONGODB_URI=mongodb://localhost:27017/arcandform

# Development/Test In-Memory Database
# Explicit opt-in only. Must NEVER be enabled in production.
USE_MEMORY_DB=false

# Authentication & Security
# Preserves existing Spring Boot security contracts:
# - Cookie name: arc_token
# - Cookie SameSite: Lax (dev) / None (prod cross-origin)
# - Cookie Secure: false (dev) / true (prod)
# - Expiration: 7 days (604800000 ms)
JWT_SECRET=arc_and_form_dev_secret_key_change_in_production_min_32_chars
JWT_EXPIRATION_MS=604800000
COOKIE_NAME=arc_token
COOKIE_SECURE=false
COOKIE_SAME_SITE=Lax

# CORS Configuration
# Comma-separated list of allowed origins matching frontend dev & preview ports
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:5175,http://localhost:3000

# Client Frontend URL
CLIENT_URL=http://localhost:5173

# Stripe Payment Gateway Configuration (Phase 5)
# Set your Stripe API Secret Key (starts with sk_test_... or sk_live_...)
STRIPE_SECRET_KEY=sk_test_placeholder_replace_with_actual_key
# Stripe Webhook Signing Secret (starts with whsec_...) from the Stripe Dashboard or CLI
STRIPE_WEBHOOK_SECRET=whsec_placeholder_replace_with_actual_key
# Redirect URLs for Stripe Checkout Session
STRIPE_SUCCESS_URL=http://localhost:5173/checkout/success?session_id={CHECKOUT_SESSION_ID}
STRIPE_CANCEL_URL=http://localhost:5173/checkout?cancelled=true

# Cloudinary Image Uploads Configuration (Phase 6)
# Provided from your Cloudinary console; left empty for development mock mode
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

